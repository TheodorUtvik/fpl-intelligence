venv/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store

# Auto-generated processed files are not committed (rebuilt by Stage 2)
data/processed/*.parquet
# Exception: hand-curated FPL↔Understat ID map must live in the repo
!data/processed/player_id_map.parquet

# Raw FPL + Understat parquets ARE committed — Stage 1 fetches and commits
# them; Stage 2 reads them on a clean CI runner. Do not gitignore these.

# Model artefacts — PNGs are visualisations only, not needed by CI
models/*.png
# model weights, explainer and feature list ARE committed (Stage 2 rebuilds them)
# models/*.json and models/*.pkl are intentionally NOT ignored

# Jupyter checkpoints
.ipynb_checkpoints/

# Environment
.env
